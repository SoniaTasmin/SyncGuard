# Copy to .env (which is git-ignored) and choose your own value.
# SQL Server requires 8+ chars with upper, lower, digit and symbol. Avoid ';' and quotes (it is embedded in connection strings).
MSSQL_SA_PASSWORD=Change-Me-Local-Only-1

# Demo-only failure injection on the mock destination. Never enable outside a local demo.
FAULT_INJECTION_ENABLED=true
